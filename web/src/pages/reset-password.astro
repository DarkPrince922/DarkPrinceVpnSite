---
import Auth from "../layouts/Auth.astro";
---

<Auth title="Новый пароль">
    <div class="card">
        <h2 id="title" style="text-align:center">Новый пароль</h2>
        <div id="message" class="msg hidden"></div>

        <form id="form">
            <label class="field">
                <span>Новый пароль (не короче восьми символов)</span>
                <input type="password" id="password" minlength="8" autocomplete="new-password" required />
            </label>
            <label class="field">
                <span>Ещё раз</span>
                <input type="password" id="repeat" minlength="8" autocomplete="new-password" required />
            </label>
            <button class="btn btn-primary btn-block" id="submit" type="submit">Сохранить пароль</button>
        </form>

        <div id="done" class="hidden" style="text-align:center;margin-top:14px">
            <a class="btn btn-primary" href="/cabinet.html">Войти с новым паролем</a>
        </div>
    </div>
    <script src="../scripts/reset-password.js"></script>
</Auth>
