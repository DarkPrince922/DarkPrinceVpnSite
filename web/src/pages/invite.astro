---
import Auth from "../layouts/Auth.astro";
---

<Auth title="Приглашение">
    <div class="card" style="text-align:center">
        <h2 id="title">Вас пригласили в DarkPrince VPN</h2>
        <p class="small muted" id="text">
            Быстрый VPN для телефона и компьютера. Зарегистрируйтесь удобным способом — приглашение
            засчитается само.
        </p>
        <p class="small gold hidden" id="bonus"></p>
        <div id="actions" style="display:grid;gap:10px;margin-top:16px">
            <a class="btn btn-primary btn-block" id="telegram" href="https://t.me/VPNbyDPrincebot">Через Telegram</a>
            <a class="btn btn-block" id="email" href="/cabinet.html?register=1">По почте</a>
        </div>
        <p class="tiny muted" id="hint" style="margin-top:14px">
            Через Telegram — откроется наш бот, нажмите «Старт». По почте — откроется регистрация на
            сайте, код приглашения уже будет вписан.
        </p>
        <p style="margin-top:14px"><a class="small" href="/">Скачать приложения</a></p>
    </div>
    <script src="../scripts/invite.js"></script>
</Auth>
