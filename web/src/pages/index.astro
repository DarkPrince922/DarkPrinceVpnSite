---
import Base from "../layouts/Base.astro";
import { guide } from "../data-guide";

/**
 * Приложения по платформам. Ссылки и подписи под кнопками подменяет
 * `home.js` из downloads.json — здесь то, что видно без скриптов и в поиске.
 */
const platforms = [
    {
        id: "android",
        icon: "android",
        title: "Android",
        note: "Android 8 и новее",
        cta: "Скачать APK",
        href: "/downloads/DarkPrinceVPN.apk",
        version: true,
    },
    {
        id: "windows",
        icon: "windows",
        title: "Windows",
        note: "Windows 10 и 11",
        cta: "Скачать для Windows",
        href: "/downloads/DarkPrinceVPN-setup.exe",
        version: true,
    },
    {
        id: "ios",
        icon: "ios",
        title: "iPhone и iPad",
        note: "Через INCY из App Store",
        cta: "Установить INCY",
        href: "https://apps.apple.com/app/id6756943388",
        external: true,
        fixed: "iOS 15 и новее",
    },
    {
        id: "linux",
        icon: "linux",
        title: "Linux",
        note: "Arch, Ubuntu и любой другой",
        cta: "Скачать для Linux",
        href: "/downloads/DarkPrinceVPN.AppImage",
        version: true,
    },
];

const features = [
    {
        icon: "bolt",
        title: "Скорость без потолка",
        note: "Протоколы поверх обычного HTTPS: провайдер видит только защищённое соединение.",
    },
    {
        icon: "apps",
        title: "Выбор приложений",
        note: "Банки и доставку — напрямую, остальное — через VPN.",
    },
    {
        icon: "devices",
        title: "Несколько устройств",
        note: "Телефон, ноутбук и компьютер одновременно.",
    },
];

/** Значки — те же контуры, что в приложениях (AquaIcon). */
const icons: Record<string, string> = {
    android: '<path d="M5 16V11a7 7 0 0 1 14 0v5z"/><path d="M7.5 5.5L6 3.5M16.5 5.5L18 3.5"/><path d="M8 16v3.5M16 16v3.5"/><circle cx="9.5" cy="10.5" r=".6"/><circle cx="14.5" cy="10.5" r=".6"/>',
    windows: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
    ios: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
    linux: '<rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="M7 10l3 2.5L7 15M12.5 15H17"/>',
    bolt: '<path d="M13 3L5 13.5h6L10 21l8-10.5h-6z"/>',
    apps: '<rect x="4" y="4" width="6.5" height="6.5" rx="2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="2"/><path d="M16.7 13.5v6.5M13.5 16.7H20"/>',
    devices: '<rect x="3" y="5" width="13" height="10" rx="2"/><path d="M6 19h7"/><rect x="17" y="9" width="4.5" height="10" rx="1.5"/>',
};

/** Кусок главного экрана приложения для витрины — данные условные. */
const demo = [
    ["🇩🇪", "Германия · Франкфурт", "VLESS · REALITY · TCP", 42],
    ["🇳🇱", "Нидерланды · Лимбург", "VLESS · REALITY · XHTTP", 76],
    ["🇵🇱", "Польша · Варшава", "VLESS · REALITY · TCP", 36],
    ["🇸🇪", "Швеция · Стокгольм", "VLESS · TLS · WS", 185],
    ["🇫🇮", "Финляндия · Хельсинки", "VLESS · REALITY · TCP", 51],
];

const builds = [
    {
        key: "arch",
        title: "Arch, Manjaro, EndeavourOS",
        note: "Пакет pacman: встаёт под учёт системы и так же удаляется.",
        href: "/downloads/DarkPrinceVPN.pkg.tar.zst",
    },
    {
        key: "deb",
        title: "Ubuntu, Debian, Mint, Pop!_OS",
        note: "Пакет .deb: открывается двойным щелчком или sudo apt install ./файл.",
        href: "/downloads/DarkPrinceVPN.deb",
    },
    {
        key: "appimage",
        title: "Fedora, openSUSE и любой другой",
        note: "AppImage: ставить не нужно, но файл придётся сделать исполняемым и ярлык сам не появится.",
        href: "/downloads/DarkPrinceVPN.AppImage",
    },
];
---

<Base
    title="DarkPrince VPN — быстрый VPN для Android, iPhone, Windows и Linux"
    description="Приложения DarkPrince VPN для Android, iPhone, Windows и Linux. Скачайте, войдите и подключайтесь — без настроек и ограничений скорости."
>
    <section class="hero wrap">
        {/* Карта серверов из точек: дуги от нас к странам, где стоят узлы, —
            как карта подключения в приложении. Один файл SVG, без скриптов. */}
        <div class="hero-bg" aria-hidden="true"><img class="hero-map" src="/assets/world-dots.svg" alt="" width="1600" height="800" /></div>
        <div class="hero-text">
            <span class="chip">Android · Windows · Linux · iPhone</span>
            <h1>Интернет без границ <em>в одну кнопку</em></h1>
            <p class="lead">
                Своё приложение для телефона и компьютера: скачали, вошли, нажали. Без конфигов,
                без ограничений скорости.
            </p>
            <div class="hero-cta">
                <a class="btn btn-primary" id="mainDownload" href="#downloads">
                    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
                    <span>Скачать приложение</span>
                </a>
                <a class="btn" href="#downloads">Все платформы</a>
            </div>
            <div class="trust">
                <div><b>4</b><span>платформы</span></div>
                <div><b>Без логов</b><span>трафик не пишем</span></div>
                <div><b>1 кнопка</b><span>вместо конфигов</span></div>
            </div>
        </div>

        {/* Витрина: главный экран приложения. Картинкой не делаем — так он
            чёткий на любом экране и весит меньше любого скриншота. */}
        {/* Живой макет приложения: кнопку можно нажать, сервер — выбрать,
            вкладки — переключить. Ведёт его phone.ts, данные условные. */}
        <div class="hero-phone">
            <div class="phone" id="demoPhone" data-on="1">
                <div class="ph-head"><span>DARKPRINCE</span><b id="phConn">🇩🇪 Франкфурт · 00:42:24</b></div>

                <div class="ph-screen on" data-screen="home">
                    <div class="ph-hero">
                        <button class="ph-disc" id="phPower" aria-label="Подключиться или отключиться">
                            <svg class="ic on-ic" viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.6c0 4.4-3 8-7.5 9.4-4.5-1.4-7.5-5-7.5-9.4V6z" /><path d="M8.8 12.2l2.3 2.3 4.2-4.4" /></svg>
                            <svg class="ic off-ic" viewBox="0 0 24 24"><path d="M12 3v9" /><path d="M17.7 6.8a8 8 0 1 1-11.4 0" /></svg>
                            <i class="ph-arc"></i>
                        </button>
                        <div><b id="phTitle">Защищено</b><span id="phLine">↓ 1,24 ГБ · ↑ 86,3 МБ</span></div>
                    </div>
                    <div class="ph-card">
                        <span class="ph-tile"><svg class="ic" viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.6c0 4.4-3 8-7.5 9.4-4.5-1.4-7.5-5-7.5-9.4V6z" /></svg></span>
                        <div><b>Семья</b><span>до 10.12</span></div>
                        <span class="chip">23 дня</span>
                    </div>
                    <div class="ph-lh"><span>СЕРВЕРЫ · 5</span><span><button class="ph-chip" id="phPing">Пинг</button><button class="ph-chip" id="phRefresh" aria-label="Обновить">↻</button></span></div>
                    <div class="ph-list" id="phList">
                        {
                            demo.map(([flag, name, tags, ping], index) => (
                                <button class={index === 0 ? "ph-row sel" : "ph-row"} data-flag={flag} data-city={String(name).split(" · ")[1]}>
                                    <span class="ph-flag">{flag}</span>
                                    <div><b>{name}</b><span>{tags}</span></div>
                                    <em data-ping={ping}>{ping}<small>мс</small></em>
                                </button>
                            ))
                        }
                    </div>
                </div>

                <div class="ph-screen" data-screen="plans">
                    <div class="ph-title">Тарифы</div>
                    <div class="ph-list">
                        <div class="ph-row"><div><b>Сутки</b><span>10 ГБ · 1 устройство</span></div><em class="ph-price">10 ₽/день</em></div>
                        <div class="ph-row"><div><b>Старт</b><span>100 ГБ · 2 устройства</span></div><em class="ph-price">200 ₽</em></div>
                        <div class="ph-row"><div><b>Оптимум</b><span>200 ГБ · 3 устройства</span></div><em class="ph-price">270 ₽</em></div>
                        <div class="ph-row sel"><div><b>Семья</b><span>Безлимит · 5 устройств</span></div><em class="ph-price">350 ₽</em></div>
                    </div>
                    <p class="ph-note">Цены за 30 дней</p>
                    <div class="ph-btn">Продлить за 350 ₽</div>
                </div>

                <div class="ph-screen" data-screen="balance">
                    <div class="ph-title">Баланс</div>
                    <div class="ph-card ph-money"><span>На счёте</span><b>1 245 ₽</b></div>
                    <div class="ph-keys">{["300 ₽", "500 ₽", "1000 ₽"].map((sum) => <span>{sum}</span>)}</div>
                    <div class="ph-btn">Пополнить</div>
                </div>

                <div class="ph-screen" data-screen="more">
                    <div class="ph-title">Ещё</div>
                    <div class="ph-list">
                        {["Приложения через VPN", "Подключённые устройства", "Пригласить друга", "Техподдержка"].map((row) => (
                            <div class="ph-row"><div><b>{row}</b></div><em>›</em></div>
                        ))}
                    </div>
                </div>

                <div class="ph-dock" id="phDock">
                    <button class="on" data-go="home"><svg class="ic" viewBox="0 0 24 24"><path d="M4 11l8-7 8 7v8.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" /></svg><span>Главная</span></button>
                    <button data-go="plans"><svg class="ic" viewBox="0 0 24 24"><path d="M3 4h2.5l2.2 10.5h10.3l2-7.5H7" /><circle cx="9.5" cy="19" r="1.3" /><circle cx="17" cy="19" r="1.3" /></svg><span>Тарифы</span></button>
                    <button data-go="balance"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="3" /><path d="M3 10h18" /></svg><span>Баланс</span></button>
                    <button data-go="more"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3M5.5 5.5l2.1 2.1M16.4 16.4l2.1 2.1M5.5 18.5l2.1-2.1M16.4 7.6l2.1-2.1" /></svg><span>Ещё</span></button>
                </div>
            </div>
            <p class="ph-hint">Это живой макет — нажмите на кнопку или выберите сервер</p>
        </div>
    </section>

    <section class="wrap" id="downloads">
        <div class="section-head">
            <p class="eyebrow">Приложения</p>
            <h2>Скачайте под свою систему</h2>
        </div>
        <div class="grid cols-4">
            {
                platforms.map((p) => (
                    <a
                        class="card platform"
                        id={`dl${p.id[0].toUpperCase()}${p.id.slice(1)}`}
                        href={p.href}
                        {...(p.external ? { target: "_blank", rel: "noopener" } : {})}
                    >
                        <span class="tile"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[p.icon]} /></span>
                        <h3>{p.title}</h3>
                        <p class="small muted">{p.note}</p>
                        <span class="platform-foot">
                            <span class="chip" id={p.version ? `ver${p.id[0].toUpperCase()}${p.id.slice(1)}` : undefined}>
                                {p.fixed ?? p.cta}
                            </span>
                            <svg class="ic chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                        </span>
                    </a>
                ))
            }
        </div>
        <div class="grid cols-3 features">
            {
                features.map((f) => (
                    <article class="card feature">
                        <span class="tile"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} /></span>
                        <div>
                            <h3>{f.title}</h3>
                            <p class="small muted">{f.note}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>

    <section class="wrap" id="install">
        <div class="section-head">
            <p class="eyebrow">Как начать</p>
            <h2>Подключение за 3 минуты</h2>
            <p>
                Вкладку вашей системы мы выбрали сами. У каждого шага — то, что вы увидите на экране, и
                обведено, что нажать. Подробнее — в <a href="/help.html">справке</a>.
            </p>
        </div>

        <div class="g-tabs tabs" role="tablist">
            {
                Object.entries(guide).map(([key, item], index) => (
                    <button role="tab" data-tab={key} aria-selected={String(index === 0)}>
                        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[key]} />
                        <span>{item.name}</span>
                    </button>
                ))
            }
        </div>

        {
            Object.entries(guide).map(([key, item], index) => (
                <div class={index === 0 ? "guide" : "guide hidden"} data-panel={key}>
                    <ol class="g-steps">
                        {item.steps.map((step, n) => (
                            <li>
                                <button class={n === 0 ? "g-step on" : "g-step"} data-step={n}>
                                    <span class="g-n">{n + 1}</span>
                                    <span class="g-t"><b>{step.title}</b><span>{step.sub}</span></span>
                                    <svg class="ic chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                                </button>
                            </li>
                        ))}
                    </ol>
                    <div class="g-shows">
                        {item.steps.map((step, n) => (
                            <div class={n === 0 ? "g-show on" : "g-show"} data-show={n}>
                                <h3>{step.head}</h3>
                                <p>{step.text}</p>
                                <div class="g-shot" set:html={step.shot} />
                                <div class="g-actions">
                                    {step.action && (
                                        <a
                                            class="btn btn-primary"
                                            href={step.action.href}
                                            id={step.action.id}
                                            {...(step.action.external ? { target: "_blank", rel: "noopener" } : {})}
                                        >
                                            {step.action.text}
                                        </a>
                                    )}
                                    {n < item.steps.length - 1 && (
                                        <button class="btn g-next" data-next={n + 1}>Дальше →</button>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </section>

    <section class="wrap" id="ios-note">
        <div class="card">
            <h3>Почему для iPhone нет своего приложения</h3>
            <p class="small muted" style="margin-top:10px">
                Честно: для App Store нужен платный аккаунт разработчика Apple — мы этим занимаемся.
                Но подписка у нас в обычном стандартном формате, поэтому подойдёт любой популярный
                клиент, и работать он будет ровно так же: те же серверы, та же скорость, тот же лимит
                устройств. Инструкция — на вкладке выше.
            </p>
        </div>
    </section>

    {/*
      Выбор сборки для Linux. Приложение одно, отличается только упаковка,
      поэтому спрашиваем дистрибутив, а не «версию». Ссылки настоящие, так что
      без JS и по «сохранить ссылку как» всё тоже работает.
    */}
    <dialog id="linuxPicker" class="picker" aria-labelledby="pickerTitle">
        <div class="picker-head">
            <h3 id="pickerTitle">Какой у вас дистрибутив?</h3>
            <button class="btn btn-sm btn-ghost" id="pickerClose" aria-label="Закрыть">✕</button>
        </div>
        <p class="small muted">Приложение одно и то же — отличается только формат пакета.</p>

        <ul class="picker-list">
            {
                builds.map((b) => (
                    <li>
                        <div>
                            <b>{b.title}</b>
                            <p class="small muted">{b.note}</p>
                        </div>
                        <a class="btn btn-primary btn-sm" data-pick={b.key} href={b.href}>
                            Скачать
                        </a>
                    </li>
                ))
            }
        </ul>

        <p class="tiny picker-foot">
            Всё собрано под x86_64. Для другого процессора приложение собирается из исходников — как,
            написано в
            <a href="https://github.com/DarkPrince922/DarkPrinceVpnLinux" target="_blank" rel="noopener"
                >репозитории</a
            >.
        </p>
    </dialog>

    <script src="../scripts/home.ts"></script>
    <script src="../scripts/phone.ts"></script>
</Base>
