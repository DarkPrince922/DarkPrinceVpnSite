---
import Base from "../layouts/Base.astro";

/**
 * Приложения по платформам. Ссылки и подписи под кнопками подменяет
 * `home.js` из downloads.json — здесь то, что видно без скриптов и в поиске.
 */
const platforms = [
    {
        id: "android",
        icon: "🤖",
        title: "Android",
        note: "Телефоны и планшеты, Android 8 и новее. Есть выбор приложений для VPN и кнопка в шторке.",
        cta: "Скачать APK",
        href: "/downloads/DarkPrinceVPN.apk",
        version: true,
    },
    {
        id: "windows",
        icon: "🪟",
        title: "Windows",
        note: "Windows 10 и 11. Два режима: системный прокси без прав администратора и полный туннель для всех программ.",
        cta: "Скачать для Windows",
        href: "/downloads/DarkPrinceVPN-setup.exe",
        version: true,
    },
    {
        id: "ios",
        icon: "🍏",
        title: "iPhone и iPad",
        note: "Своего приложения в App Store пока нет — подключение через INCY, бесплатный клиент из App Store. Ссылку возьмёте в кабинете.",
        cta: "Установить INCY",
        href: "https://apps.apple.com/app/id6756943388",
        external: true,
        fixed: "App Store · iOS 15 и новее",
    },
    {
        id: "linux",
        icon: "🐧",
        title: "Linux",
        note: "Своё приложение: те же два режима, что в Windows. Пакет для вашего дистрибутива — ставится в систему, ярлык появляется в меню.",
        cta: "Скачать для Linux",
        href: "/downloads/DarkPrinceVPN.AppImage",
        version: true,
    },
];

const features = [
    {
        icon: "⚡",
        title: "Скорость без потолка",
        note: "Современные протоколы поверх обычного HTTPS-трафика: провайдер видит только защищённое соединение.",
    },
    {
        icon: "🧩",
        title: "Выбор приложений",
        note: "На Android можно пустить через VPN только нужные приложения, а банки и доставку оставить напрямую.",
    },
    {
        icon: "👥",
        title: "Одна подписка — несколько устройств",
        note: "Телефон, компьютер и ноутбук работают одновременно, устройствами можно управлять в кабинете.",
    },
];

const builds = [
    {
        key: "arch",
        title: "Arch, Manjaro, EndeavourOS",
        note: "Пакет pacman: встаёт под учёт системы и так же удаляется.",
        href: "/downloads/DarkPrinceVPN.pkg.tar.zst",
    },
    {
        key: "deb",
        title: "Ubuntu, Debian, Mint, Pop!_OS",
        note: "Пакет .deb: открывается двойным щелчком или sudo apt install ./файл.",
        href: "/downloads/DarkPrinceVPN.deb",
    },
    {
        key: "appimage",
        title: "Fedora, openSUSE и любой другой",
        note: "AppImage: ставить не нужно, но файл придётся сделать исполняемым и ярлык сам не появится.",
        href: "/downloads/DarkPrinceVPN.AppImage",
    },
];
---

<Base
    title="DarkPrince VPN — быстрый VPN для Android, iPhone, Windows и Linux"
    description="Приложения DarkPrince VPN для Android, iPhone, Windows и Linux. Скачайте, войдите и подключайтесь — без настроек и ограничений скорости."
>
    <section class="hero wrap">
        <div class="hero-mark">
            <img src="/assets/logo.png" alt="DarkPrince VPN" width="54" height="54" />
        </div>
        <h1>Интернет без границ <em>на всех ваших устройствах</em></h1>
        <p class="lead">
            Своё приложение для телефона и компьютера: скачали, вошли, нажали одну кнопку.
            Без ручной настройки конфигов, без ограничений скорости и без счётчика трафика
            там, где он не нужен.
        </p>

        <div class="hero-cta">
            <a class="btn btn-primary" id="mainDownload" href="#downloads">Скачать приложение</a>
            <a class="btn" href="/cabinet.html">Личный кабинет</a>
        </div>
        <p class="tiny hero-note">Остальные платформы — ниже</p>

        <div class="trust">
            <div><b>4</b><span>платформы</span></div>
            <div><b>Без логов</b><span>трафик не пишем</span></div>
            <div><b>1 кнопка</b><span>вместо конфигов</span></div>
            <div><b>Своё ядро</b><span>ничего доскачивать</span></div>
        </div>
    </section>

    <section class="wrap" id="downloads">
        <div class="section-head">
            <p class="eyebrow">Приложения</p>
            <h2>Скачайте под свою систему</h2>
            <p>Версия и размер подставляются автоматически — то, что лежит на сервере прямо сейчас.</p>
        </div>

        <div class="grid cols-4">
            {
                platforms.map((p) => (
                    <article class="card platform">
                        <span class="icon">{p.icon}</span>
                        <h3>{p.title}</h3>
                        <p class="small muted">{p.note}</p>
                        <a
                            class="btn btn-primary btn-block"
                            id={`dl${p.id[0].toUpperCase()}${p.id.slice(1)}`}
                            href={p.href}
                            {...(p.external
                                ? { target: "_blank", rel: "noopener" }
                                : {})}
                        >
                            {p.cta}
                        </a>
                        <p class="size" id={p.version ? `ver${p.id[0].toUpperCase()}${p.id.slice(1)}` : undefined}>
                            {p.fixed ?? " "}
                        </p>
                    </article>
                ))
            }
        </div>
    </section>

    <section class="wrap">
        <div class="grid cols-3">
            {
                features.map((f) => (
                    <article class="card feature">
                        <span class="icon">{f.icon}</span>
                        <h3>{f.title}</h3>
                        <p class="small muted">{f.note}</p>
                    </article>
                ))
            }
        </div>
    </section>

    <section class="wrap" id="install">
        <div class="section-head">
            <p class="eyebrow">Как начать</p>
            <h2>Три шага до подключения</h2>
            <p>Вкладка откроется на вашей системе — её мы определяем сами.</p>
        </div>

        <div class="card">
            <div class="tabs" role="tablist">
                <button role="tab" aria-selected="true" data-tab="android">Android</button>
                <button role="tab" aria-selected="false" data-tab="ios">iPhone</button>
                <button role="tab" aria-selected="false" data-tab="windows">Windows</button>
                <button role="tab" aria-selected="false" data-tab="linux">Linux</button>
            </div>

            <ol class="steps" data-panel="android">
                <li>
                    <b>Скачайте APK</b> кнопкой выше. Android спросит разрешение на установку из
                    этого источника — его нужно дать: приложения нет в Google Play, и это нормально
                    для VPN.
                </li>
                <li>
                    <b>Установите и откройте.</b> Войдите через Telegram — если вы уже покупали
                    подписку у бота, всё подтянется само.
                </li>
                <li>
                    <b>Нажмите кнопку подключения</b> и разрешите создание VPN-профиля. Это системный
                    запрос Android, он появится один раз.
                </li>
            </ol>

            <ol class="steps hidden" data-panel="ios">
                <li>
                    <b>Установите INCY</b> из
                    <a href="https://apps.apple.com/app/id6756943388" target="_blank" rel="noopener"
                        >App Store</a
                    >. Приложение бесплатное. Если в вашем App Store его не видно, переключите страну
                    аккаунта — приложение доступно не во всех регионах.
                </li>
                <li>
                    <b>Скопируйте ссылку подписки</b> в
                    <a href="/cabinet.html">личном кабинете</a>, раздел «Подключение». Там же есть
                    QR-код — его можно отсканировать с другого устройства.
                </li>
                <li>
                    <b>В INCY откройте подписки</b> и добавьте новую по ссылке: приложение принимает
                    ссылку из буфера обмена и QR-код. Список серверов подтянется сам.
                </li>
                <li>
                    <b>Выберите сервер и подключитесь.</b> iOS один раз спросит разрешение на добавление
                    VPN-конфигурации — его нужно дать.
                </li>
            </ol>

            <ol class="steps hidden" data-panel="windows">
                <li>
                    <b>Запустите установщик.</b> Windows покажет предупреждение SmartScreen — программа
                    не подписана сертификатом. Нажмите «Подробнее» → «Выполнить в любом случае». Всё
                    нужное, включая ядро, уже внутри — доскачивать ничего не надо.
                </li>
                <li>
                    <b>Войдите</b> через Telegram или по почте — тем же аккаунтом, что и в боте. Список
                    серверов и подписка подтянутся сами.
                </li>
                <li>
                    <b>Выберите режим.</b> «Прокси» работает без прав администратора и подходит
                    браузерам. «Весь трафик» перехватывает всё, включая игры и торренты, — для него
                    приложение попросит перезапуск от администратора.
                </li>
                <li>
                    <b>Закрытие окна не выключает VPN.</b> Крестик спросит: свернуть в трей (значок у
                    часов) или выйти совсем. Подключиться и отключиться можно прямо из меню значка.
                </li>
            </ol>

            <ol class="steps hidden" data-panel="linux">
                <li>
                    <b>Выберите дистрибутив.</b> Кнопка выше открывает окно с тремя сборками: пакет для
                    Arch, .deb для Ubuntu и Debian, AppImage для всего остального. Приложение во всех
                    одно и то же — отличается только упаковка.
                </li>
                <li>
                    <b>Поставьте пакет.</b> На Arch —
                    <span class="mono">sudo pacman -U DarkPrinceVPN.pkg.tar.zst</span>, на Ubuntu и
                    Debian — <span class="mono">sudo apt install ./DarkPrinceVPN.deb</span>. И там, и
                    там зависимости подтянутся сами, а ярлык появится в меню. AppImage ставить не
                    нужно: сделайте файл исполняемым (<span class="mono">chmod +x</span> или свойства
                    файла → «Разрешить выполнение») и запускайте.
                </li>
                <li>
                    <b>Войдите</b> через Telegram или по почте — тем же аккаунтом, что и в боте.
                </li>
                <li>
                    <b>Выберите режим.</b> «Прокси» работает без пароля и настраивает прокси рабочего
                    стола. «Весь трафик» перехватывает всё, включая консольные программы, — система
                    один раз спросит пароль.
                </li>
                <li>
                    <b>Не хотите наше приложение?</b> Подписка в обычном формате, подойдёт
                    <a href="https://github.com/Mahdi-zarei/nekoray/releases" target="_blank" rel="noopener"
                        >Nekoray</a
                    >,
                    <a href="https://github.com/v2rayA/v2rayA" target="_blank" rel="noopener">v2rayA</a>
                    или
                    <a href="https://github.com/hiddify/hiddify-app/releases" target="_blank" rel="noopener"
                        >Hiddify</a
                    >. Ссылку возьмёте в кабинете.
                </li>
            </ol>
        </div>
    </section>

    <section class="wrap" id="ios-note">
        <div class="card">
            <h3>Почему для iPhone нет своего приложения</h3>
            <p class="small muted" style="margin-top:10px">
                Честно: для App Store нужен платный аккаунт разработчика Apple — мы этим занимаемся.
                Но подписка у нас в обычном стандартном формате, поэтому подойдёт любой популярный
                клиент, и работать он будет ровно так же: те же серверы, та же скорость, тот же лимит
                устройств. Инструкция — на вкладке выше.
            </p>
        </div>
    </section>

    {/*
      Выбор сборки для Linux. Приложение одно, отличается только упаковка,
      поэтому спрашиваем дистрибутив, а не «версию». Ссылки настоящие, так что
      без JS и по «сохранить ссылку как» всё тоже работает.
    */}
    <dialog id="linuxPicker" class="picker" aria-labelledby="pickerTitle">
        <div class="picker-head">
            <h3 id="pickerTitle">Какой у вас дистрибутив?</h3>
            <button class="btn btn-sm btn-ghost" id="pickerClose" aria-label="Закрыть">✕</button>
        </div>
        <p class="small muted">Приложение одно и то же — отличается только формат пакета.</p>

        <ul class="picker-list">
            {
                builds.map((b) => (
                    <li>
                        <div>
                            <b>{b.title}</b>
                            <p class="small muted">{b.note}</p>
                        </div>
                        <a class="btn btn-primary btn-sm" data-pick={b.key} href={b.href}>
                            Скачать
                        </a>
                    </li>
                ))
            }
        </ul>

        <p class="tiny picker-foot">
            Всё собрано под x86_64. Для другого процессора приложение собирается из исходников — как,
            написано в
            <a href="https://github.com/DarkPrince922/DarkPrinceVpnLinux" target="_blank" rel="noopener"
                >репозитории</a
            >.
        </p>
    </dialog>

    <script src="../scripts/home.ts"></script>
</Base>
