---
import Base from "./Base.astro";
import "../styles/cabinet.css";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

{/*
  Страницы по одноразовым ссылкам из писем: подтверждение почты и новый
  пароль. Шапка урезана до логотипа — предлагать «личный кабинет» человеку,
  который как раз пытается в него попасть, незачем.
*/}
<Base title={`${title} — DarkPrince VPN`} description={title} chrome={false} noindex>
    <header class="top">
        <div class="wrap">
            <a class="brand" href="/">
                <img src="/assets/logo.png" alt="" width="32" height="32" />
                <span>DarkPrince <i>VPN</i></span>
            </a>
        </div>
    </header>

    <main class="auth-wrap">
        <slot />
    </main>
</Base>
