---
import Base from "./Base.astro";
import "../styles/cabinet.css";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

{/*
  Страницы по одноразовым ссылкам: подтверждение почты, новый пароль,
  приглашение. Крупный логотип стоит над формой, поэтому в шапке его нет —
  на странице один логотип.
*/}
<Base title={`${title} — DarkPrince VPN`} description={title} logo={false} noindex>
    <div class="auth-wrap">
        <img class="auth-logo" src="/assets/wordmark.png" alt="DarkPrince VPN" width="360" height="84" />
        <slot />
    </div>
</Base>
