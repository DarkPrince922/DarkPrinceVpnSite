---
import "../styles/app.css";

interface Props {
    title: string;
    description: string;
    /** Общая шапка и подвал не нужны страницам, которые сами себе приложение. */
    chrome?: boolean;
    /** Кабинет и страницы по одноразовым ссылкам в поиске не нужны. */
    noindex?: boolean;
    /**
     * Своя политика Referer поверх серверной same-origin. Окно входа Telegram
     * узнаёт сайт по Referer: без него отвечает «origin required».
     */
    referrer?: string;
    /**
     * Логотип в шапке. Страницы, где крупный логотип стоит над формой
     * (вход, приглашение, новый пароль), его выключают: на странице — один логотип.
     */
    logo?: boolean;
}

const { title, description, chrome = true, noindex = false, referrer, logo = true } = Astro.props;
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#050a0f" />
        <link rel="icon" href="/assets/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png" />
        <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
        {noindex && <meta name="robots" content="noindex" />}
        {referrer && <meta name="referrer" content={referrer} />}

        {/* Шрифт грузится сразу: без preload первый экран рисуется системным и дёргается. */}
        <link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/inter-bold.woff2" as="font" type="font/woff2" crossorigin />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/assets/logo.png" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>

    <body>
        {/* Фон — отдельным слоем под всем содержимым, см. .scene в app.css */}
        <div class="scene" aria-hidden="true">
            <span class="glow a"></span>
            <span class="glow b"></span>
            <img class="world" src="/assets/world-dots.svg" alt="" width="1600" height="800" />
        </div>

        {
            chrome && (
                <header class="top">
                    <div class="wrap">
                        {logo ? (
                            <a class="brand" href="/" aria-label="DarkPrince VPN — на главную">
                                <img src="/assets/wordmark.png" alt="DarkPrince VPN" width="164" height="38" />
                            </a>
                        ) : (
                            <a class="back" href="/">← На главную</a>
                        )}
                        <div class="spacer" />
                        <nav class="top-nav">
                            <a href="/#downloads">Приложения</a>
                            <a href="/#install">Как начать</a>
                            <a href="/help.html">Справка</a>
                        </nav>
                        <a class="btn btn-sm" href="/cabinet.html">
                            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                            Кабинет
                        </a>
                    </div>
                </header>
            )
        }

        {
            chrome ? (
                <main>
                    <slot />
                </main>
            ) : (
                <slot />
            )
        }

        {
            chrome && (
                <footer class="bottom">
                    <div class="wrap">
                        <span class="muted">DarkPrince VPN</span>
                        <nav>
                            <a href="/help.html">Справка</a>
                            <a href="/cabinet.html#support">Поддержка</a>
                            <a href="/privacy.html">Конфиденциальность</a>
                            <a href="/terms.html">Условия</a>
                        </nav>
                        <span class="muted">
                            Помощь —{" "}
                            <a href="https://t.me/skzfeee" target="_blank" rel="noopener">@skzfeee</a>
                            {" "}· © {new Date().getFullYear()}
                        </span>
                    </div>
                </footer>
            )
        }
        <script src="../scripts/chrome.ts"></script>
    </body>
</html>
